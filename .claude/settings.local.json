{
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sf -X POST -H \"Content-Type: application/json\" -H \"X-Mux-Token: $MUX_HOOK_TOKEN\" -H \"X-Mux-Pty-Id: $MUX_PTY_ID\" -H \"X-Mux-Event-Type: notification\" -d @- \"http://127.0.0.1:$MUX_HOOK_PORT/hook\" || true"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sf -X POST -H \"Content-Type: application/json\" -H \"X-Mux-Token: $MUX_HOOK_TOKEN\" -H \"X-Mux-Pty-Id: $MUX_PTY_ID\" -H \"X-Mux-Event-Type: permission_request\" -d @- \"http://127.0.0.1:$MUX_HOOK_PORT/hook\" || true"
          }
        ]
      }
    ],
    "Stop": [

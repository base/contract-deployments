            "type": "command",
            "command": "curl -sf -X POST -H \"Content-Type: application/json\" -H \"X-Mux-Token: $MUX_HOOK_TOKEN\" -H \"X-Mux-Pty-Id: $MUX_PTY_ID\" -H \"X-Mux-Event-Type: stop\" -d @- \"http://127.0.0.1:$MUX_HOOK_PORT/hook\" || true"
          }
        ]
      }
    ],
    "PreToolUse": [

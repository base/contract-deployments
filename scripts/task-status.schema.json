{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task", "kind", "last_updated", "networks"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "task": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "kind": {"type": "string", "enum": ["active", "standby"]},
    "last_updated": {"type": "string", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"},
    "networks": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "pr", "blocksec_ticket", "signatures", "executed_tx"],
        "properties": {
          "step": {"type": "string", "enum": ["authoring", "validation", "review", "ready_to_sign", "collecting", "ready_to_execute", "executed", "canceled"]},
          "pr": {"type": ["string", "null"], "pattern": "^https://github\\.com/base/contract-deployments/pull/[1-9][0-9]*$"},
          "blocksec_ticket": {"type": ["string", "null"], "pattern": "^https://[^\\s]+$"},
          "signatures": {
            "type": "object",
            "propertyNames": {"pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["collected", "required"],
              "properties": {
                "collected": {"type": "integer", "minimum": 0},
                "required": {"type": "integer", "minimum": 1}
              }
            }
          },
          "executed_tx": {"type": ["string", "null"], "pattern": "^0x[0-9a-fA-F]{64}$"}
        }
      }
    }
  }
}

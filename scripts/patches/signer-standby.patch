diff --git a/src/lib/task-path.ts b/src/lib/task-path.ts
new file mode 100644
index 0000000..69e35e9
--- /dev/null
+++ b/src/lib/task-path.ts
@@ -0,0 +1,6 @@
+import path from 'path';
+
+export function getTaskPath(root: string, taskId: string): string {
+  const lifecycle = /^\d{4}-\d{2}-\d{2}-/.test(taskId) ? 'active' : 'standby';
+  return path.join(root, lifecycle, 'evm', 'tasks', taskId);
+}

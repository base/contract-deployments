OPERATOR_FEE_VAULT_MIN_WITHDRAWAL_AMOUNT=0
OPERATOR_FEE_VAULT_WITHDRAWAL_NETWORK=1

# Other transaction inputs are inherited from repository config/sepolia.env.
# Base Sepolia block 48381065: L2 ProxyAdmin owner() is
# 0x20f984546476DDd290eC46318785046eF68a1Cba, the alias of PROXY_ADMIN_OWNER.
# Sepolia L1 block 11957979, publicnode RPC: CB_MULTISIG getThreshold() = 3;

# v8.4.0.rc2, with AggregateVerifier 0.3.0 (fork-gated proposal intervals). Same pin as the Denim upgrade.
# https://github.com/base/contracts/commits/releases/v8.4.0/
BASE_CONTRACTS_COMMIT=8c21f6d08a36b4059ae2bb8938f1e7e758a0e962

# AggregateVerifier 0.3.0 registered by the Denim upgrade task (2026-10-07-denim-upgrade).
GAME_TYPE=621
CURRENT_AGGREGATE_VERIFIER=0x7ce3766537e065dAaF0370799e2761B52569aFe6

# AggregateVerifier proof program hashes. Every other constructor argument is read from the current
# verifier at deploy time.
#
# All three are built from base/base f3a459f, v1.5.0-rc.6 plus base/base#5794, which passes each
# game's intermediate block interval to the provers:
# https://github.com/base/base/pull/5812
#
# The TEE image hash is keccak256 of PCR0 of the AWS Nitro enclave image. PCR0 is printed by the
# Nitro Prover Enclave Build of protocols/base-proofs#516, which pins the enclave to that commit, and
# reproduced by its verify-reproducible check:
#   PCR0=2cbd0c628d01431b2417e71882a3c4eb9dd1144cb35859fc3074ef18b737efccebe5ad83d42f5daf1cc84128befd5056
#   cast keccak 0x$PCR0
AGGREGATE_VERIFIER_TEE_IMAGE_HASH=0x44cca4430eaac037ec451534ff7c9361095fa36e0f53fac9fa03f8305c879ef7

# The two ZK hashes are the SP1 range and aggregation verification keys printed by
# `just succinct vkeys --build` on that commit: both ELFs built reproducibly with
# `cargo prove build --docker` (SP1 v6.8.1 image), then the `vkeys` binary.
AGGREGATE_VERIFIER_ZK_RANGE_HASH=0x6b1c20d0762f77b5278bd8aa5a0bb0ef3d6f3d9411bdad6d4f929a0701876e35
AGGREGATE_VERIFIER_ZK_AGGREGATE_HASH=0x0046d94f58f278df6197b4f433b63085aa95999893811f6ba6dff7e001425ca7

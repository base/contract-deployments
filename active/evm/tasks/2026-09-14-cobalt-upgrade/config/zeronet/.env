OLD_AGGREGATE_VERIFIER=0x7dd0f51C71DA5243174FA829c8cf3385B06833b0

# ProtocolVersions initial state.
#
# Zeronet re-genesised at 1782348588, so every fork through Beryl is active from
# genesis. Ids are kept aligned with the Base mainnet registry because
# AggregateVerifier hardcodes upgrade index 13 (Denim) as its fast-cadence gate:
#   0 genesis, 1 canyon, 2 delta, 3 ecotone, 4 fjord, 5 granite, 6 holocene,
#   7 pectraBlobSchedule (unscheduled), 8 isthmus, 9 jovian, 10 azul, 11 beryl,
#   12 cobalt (unscheduled -- scheduled separately once an activation time is set).
PROTOCOL_VERSIONS_INITIAL_SCHEDULE=1782348588,1782348588,1782348588,1782348588,1782348588,1782348588,1782348588,0,1782348588,1782348588,1782348588,1782348588,0
# Packed semver, major 1 (1 << 96). Must be non-zero and fit in 128 bits.
PROTOCOL_VERSIONS_MINIMUM_PROTOCOL_VERSION=79228162514264337593543950336
PROTOCOL_VERSIONS_INCIDENT_RESPONDER=0x856611ed7e07d83243b15e93f6321f2df6865852

# AggregateVerifier redeploy inputs, all read from the live game implementation at
# 0x7dd0f51C71DA5243174FA829c8cf3385B06833b0 so the redeploy carries them over
# unchanged. The pinned commit reverts the slow/fast cadence split, so there is a
# single interval pair again, matching the live values. BLOCK_INTERVAL must be
# divisible by INTERMEDIATE_BLOCK_INTERVAL, and the resulting count fixes the CWIA
# extraData layout for the lifetime of the implementation.
AGGREGATE_VERIFIER_CONFIG_HASH=0xd14ddabfc0ad1dd737d6e5917cf271fd479bd539c9b3d85a602589c679a9983a
AGGREGATE_VERIFIER_TEE_IMAGE_HASH=0x0b70f5a605b7f0dd56facb70f4d0f37042d6a448cc3deefff7475fdd4ab549c1
AGGREGATE_VERIFIER_ZK_RANGE_HASH=0x5fd09a2f4338ca7063bc37b02f9411645d0ef2784fe644cc71ab48ae64200beb
AGGREGATE_VERIFIER_ZK_AGGREGATE_HASH=0x00a147f0c69da81e3d530cca91310f9605f980dc155726bb33fbde0e493a3836
AGGREGATE_VERIFIER_BLOCK_INTERVAL=600
AGGREGATE_VERIFIER_INTERMEDIATE_BLOCK_INTERVAL=30

# L2 chain geometry used to map activation timestamps onto block numbers.
L2_GENESIS_BLOCK_NUMBER=0
L2_GENESIS_TIMESTAMP=1782348588
L2_BLOCK_TIME=2

# OptimismPortal2 constructor argument, matching the live proxy.
PROOF_MATURITY_DELAY_SECONDS=0

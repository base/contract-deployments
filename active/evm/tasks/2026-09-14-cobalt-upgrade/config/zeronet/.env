# https://github.com/base/contracts/commit/0ae2de1133aa63b689f2d80834004b85c212bddc
BASE_CONTRACTS_COMMIT=0ae2de1133aa63b689f2d80834004b85c212bddc
RECORD_STATE_DIFF=true

# Rollback anchors verified against Zeronet before task creation.
OLD_OPTIMISM_PORTAL_IMPL=0xc1ad6d4e8da1403b9eb6a99491899577050f4863
OLD_SYSTEM_CONFIG_IMPL=0xb54d7ff110995029b89a0045128cae42c931aa83

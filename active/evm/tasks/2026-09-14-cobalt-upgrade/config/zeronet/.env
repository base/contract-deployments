# https://github.com/base/contracts/commits/releases/v8.3.0/
BASE_CONTRACTS_COMMIT=385f21a41f277d287db92fffe88dca41299162ea

# Rollback anchors verified against Zeronet before task creation.
OLD_OPTIMISM_PORTAL_IMPL=0xc1ad6d4e8da1403b9eb6a99491899577050f4863
OLD_SYSTEM_CONFIG_IMPL=0xb54d7ff110995029b89a0045128cae42c931aa83
OLD_DISPUTE_GAME_FACTORY_IMPL=0x3a0a9e5b91709bba0bcb4bb4b66730dcfef6e926
OLD_AGGREGATE_VERIFIER=0x7dd0f51C71DA5243174FA829c8cf3385B06833b0

# ProtocolVersions initial state.
#
# Zeronet re-genesised at 1782348588. Every fork through Jovian is active from genesis,
# but Azul and Beryl activated shortly after it, so they carry their own timestamps.
# Ids are kept aligned with the Base mainnet registry so that an index means the same
# fork on every chain. Timestamps must match the node's ZERONET chain config in
# base/base crates/common/chains/src/config.rs:
#   0 genesis, 1 canyon, 2 delta, 3 ecotone, 4 fjord, 5 granite, 6 holocene,
#   7 pectraBlobSchedule (unscheduled), 8 isthmus, 9 jovian, all at 1782348588,
#   10 azul  -> 1782348888, genesis + 300s
#   11 beryl -> 1782349188, genesis + 600s
#   12 cobalt -> 1789574400, which is 2026-09-16 16:00:00 UTC:
#      date -u -r 1789574400
PROTOCOL_VERSIONS_INITIAL_SCHEDULE=1782348588,1782348588,1782348588,1782348588,1782348588,1782348588,1782348588,0,1782348588,1782348588,1782348888,1782349188,1789574400

# Minimum protocol version, set to v1.3.2. The OP protocol version format packs the
# low 16 bytes as major || minor || patch || pre-release, four bytes each, so v1.3.2
# is 0x00000001_00000003_00000002_00000000. Re-derive with:
#      cast to-dec 0x00000001000000030000000200000000
# Must be non-zero and fit in 128 bits.
PROTOCOL_VERSIONS_MINIMUM_PROTOCOL_VERSION=79228162569604569823262539776
PROTOCOL_VERSIONS_INCIDENT_RESPONDER=0x856611ed7e07d83243b15e93f6321f2df6865852

# AggregateVerifier proof program hashes. Every other constructor argument is read
# from the live implementation at deploy time, so these are the only values that
# change.
AGGREGATE_VERIFIER_TEE_IMAGE_HASH=0xe8dc2300cf325b2527cbfa5e664a70acc40a9f2fc0617bd35cdfa61652a5fc30
AGGREGATE_VERIFIER_ZK_RANGE_HASH=0x7713943c2c2412314b135c5606cdb3923a54f7555d91d9f31c2f64e34e16f2f4
AGGREGATE_VERIFIER_ZK_AGGREGATE_HASH=0x002663a1072dc1e1938e13d3b269fff88e843eb4ef76d6c6953dde4f5152973b

# L2 chain geometry, used to map activation timestamps onto block numbers. The live
# implementation predates ScheduleConfig, so these cannot be copied from it.
L2_GENESIS_BLOCK_NUMBER=0
L2_GENESIS_TIMESTAMP=1782348588
L2_BLOCK_TIME=2

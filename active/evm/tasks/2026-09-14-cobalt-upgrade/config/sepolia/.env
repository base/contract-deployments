# ProtocolVersions initial state.
#
# Ids are kept aligned with the Base mainnet registry so that an index means the
# same fork on every chain. Timestamps must match the node's SEPOLIA chain config
# in base/base crates/common/chains/src/config.rs:
#   0 genesis/regolith -> 1695768288  2023-09-26 22:44:48 UTC
#   1 canyon           -> 1699981200  2023-11-14 17:00:00 UTC
#   2 delta            -> 1703203200  2023-12-22 00:00:00 UTC
#   3 ecotone          -> 1708534800  2024-02-21 17:00:00 UTC
#   4 fjord            -> 1716998400  2024-05-29 16:00:00 UTC
#   5 granite          -> 1723478400  2024-08-12 16:00:00 UTC
#   6 holocene         -> 1732633200  2024-11-26 15:00:00 UTC
#   7 pectraBlobSchedule -> 1742486400  2025-03-20 16:00:00 UTC
#   8 isthmus          -> 1744905600  2025-04-17 16:00:00 UTC
#   9 jovian           -> 1763568001  2025-11-19 16:00:01 UTC
#   10 azul            -> 1776708000  2026-04-20 18:00:00 UTC
#   11 beryl           -> 1781805600  2026-06-18 18:00:00 UTC
#   12 cobalt          -> 1790186400  2026-09-23 18:00:00 UTC
#      date -u -r 1790186400
PROTOCOL_VERSIONS_INITIAL_SCHEDULE=1695768288,1699981200,1703203200,1708534800,1716998400,1723478400,1732633200,1742486400,1744905600,1763568001,1776708000,1781805600,1790186400

# Minimum protocol version, set to v1.3.2. The OP protocol version format packs the
# low 16 bytes as major || minor || patch || pre-release, four bytes each, so v1.3.2
# is 0x00000001_00000003_00000002_00000000. Re-derive with:
#      cast to-dec 0x00000001000000030000000200000000
# Must be non-zero and fit in 128 bits.
PROTOCOL_VERSIONS_MINIMUM_PROTOCOL_VERSION=79228162569604569823262539776
PROTOCOL_VERSIONS_INCIDENT_RESPONDER=0x646132A1667ca7aD00d36616AFBA1A28116C770A

# AggregateVerifier proof program hashes. Every other constructor argument is read
# from the live implementation at deploy time, so these are the only values that
# change. All three rotate for Cobalt. Leave blank until the Sepolia node release
# is confirmed; the deploy script refuses zero hashes and any hash that still
# matches the live verifier.
#
# Built from the same node release these games prove against:
#   TEE_IMAGE_HASH — PCR0 of the Sepolia AWS Nitro enclave (crates/proof/tee).
#     Chain-specific; do not copy Zeronet's value.
#   ZK_* — SP1 range and aggregation keys from `just succinct vkeys --build`.
#     If Sepolia proves against the same release as Zeronet Cobalt, these two
#     match config/zeronet/.env.
AGGREGATE_VERIFIER_TEE_IMAGE_HASH=
AGGREGATE_VERIFIER_ZK_RANGE_HASH=
AGGREGATE_VERIFIER_ZK_AGGREGATE_HASH=

# L2 chain geometry, used to map activation timestamps onto block numbers. The live
# implementation predates ScheduleConfig, so these cannot be copied from it.
L2_GENESIS_BLOCK_NUMBER=0
L2_GENESIS_TIMESTAMP=1695768288
L2_BLOCK_TIME=2

# base/contracts v8.4.0, AggregateVerifier 0.3.0.
# https://github.com/base/contracts/tree/8c21f6d08a36b4059ae2bb8938f1e7e758a0e962
BASE_CONTRACTS_COMMIT=8c21f6d08a36b4059ae2bb8938f1e7e758a0e962

# Ethereum L1 block 26250153, DisputeGameFactory.gameImpls(621).
# Network addresses and RPCs come from repository config/mainnet.env.
GAME_TYPE=621
OLD_AGGREGATE_VERIFIER=0xeF9eCeA15265321753047EBF7D54C858D53cB94f

# The live verifier's slow intervals are 600/30. At 200ms, 6000/300 preserves
# 20 intermediate roots and the 20 minute range. Cadence source:
# https://github.com/base/base/tree/5476069f1eb74a56bccb56fdefd4b4bb0e3cda42/crates/common/genesis
FAST_BLOCK_INTERVAL=6000
FAST_INTERMEDIATE_BLOCK_INTERVAL=300

# Pending reproducible v1.5.1-based prover build: PCR0 and SP1 range/aggregate vkeys
# have not been produced. Fill only from that build's verified outputs.
# base/base f3a459feaf4b071f311940510055b4b55b9374b8 cannot be used on mainnet:
# crates/common/chains/src/chain.rs sets mainnet Denim to ForkCondition::Never.
# Roll mainnet provers and proposer immediately AFTER execution, not before.
AGGREGATE_VERIFIER_TEE_IMAGE_HASH=
AGGREGATE_VERIFIER_ZK_RANGE_HASH=
AGGREGATE_VERIFIER_ZK_AGGREGATE_HASH=

# Mainnet Denim: 2026-11-05 18:00:00 UTC, upgrade id 13.
# https://github.com/base/base/blob/5476069f1eb74a56bccb56fdefd4b4bb0e3cda42/crates/common/chains/src/config.rs
# Mainnet denim_timestamp = 1_793_901_600.
# ProtocolVersions at Ethereum block 26250153 has 13 entries, last 1790791200,
# with index 7 = 0. MIN_NOTICE = 3600. Recheck the notice window before execution.
PROTOCOL_VERSIONS_DENIM_ACTIVATION_TIMESTAMP=1793901600

# ProtocolVersions.minimumProtocolVersion() at Ethereum block 26250153.
PROTOCOL_VERSIONS_CURRENT_MINIMUM_PROTOCOL_VERSION=79228162588051313896972091392
# v1.5.1 packs major || minor || patch || prerelease, each four bytes:
# python3 -c 'print((1 << 96) | (5 << 64) | (1 << 32))'
# Hex: 0x00000001000000050000000100000000
# https://github.com/base/base/releases/tag/v1.5.1
PROTOCOL_VERSIONS_MINIMUM_PROTOCOL_VERSION=79228162606498057966386675712
UPGRADE_SCRIPT_NAME=ExecuteDenimUpgradeWithAllL2Predeploys

# Base mainnet L2 block 52953400. Vaults 0x4200...0011, ...0019, ...001a
# version() = 1.3.0, RECIPIENT(), MIN_WITHDRAWAL_AMOUNT(), WITHDRAWAL_NETWORK().
# Slots 1 and 2 are empty; slot 0 holds totalProcessed, which must be preserved.
# Recipient is FeeDisburser, an existing L2 contract, so preserve L2 withdrawals.
FEE_VAULT_RECIPIENT=0x09C7bAD99688a55a2e83644BFAed09e62bDcCcBA
FEE_VAULT_MIN_WITHDRAWAL_AMOUNT=2000000000000000000
FEE_VAULT_WITHDRAWAL_NETWORK=1

# Base mainnet L2 block 52953400, ERC721 factory BRIDGE()/REMOTE_CHAIN_ID().
FACTORY_BRIDGE=0x4200000000000000000000000000000000000014
REMOTE_CHAIN_ID=1
# Same block, ERC20 factory BRIDGE(), also stored in slot 1.
# The implementation is 0x6922ac4dbdfedea3a1e5535f12c3171f2b964c91, version 1.9.0.
ERC20_FACTORY_BRIDGE=0x4200000000000000000000000000000000000010
# Same block, OperatorFeeVault RECIPIENT()/MIN_WITHDRAWAL_AMOUNT()/WITHDRAWAL_NETWORK().
OPERATOR_FEE_VAULT_RECIPIENT=0x4200000000000000000000000000000000000019
OPERATOR_FEE_VAULT_MIN_WITHDRAWAL_AMOUNT=0
OPERATOR_FEE_VAULT_WITHDRAWAL_NETWORK=1

# Base mainnet block 52953400 legacy versions:
# Messenger 1.4.0, StandardBridge 1.1.0, ERC20 factory 1.9.0, ERC721 bridge 1.1.0,
# ERC721 factory 1.2.0, OperatorFeeVault 1.0.0, SchemaRegistry/EAS 1.0.1,
# L2ToL1MessagePasser 1.0.0, L1Block 1.7.0, three fee vaults 1.3.0.
# Legacy slot 0: messenger = 1 << 160; StandardBridge/ERC721 bridge = 0;
# ERC20 factory = 1. Messenger idle sender at slot 204 = 0xdead, slot 207 = 0.
# Counterparts match repository config/mainnet.env. L2 ProxyAdmin owner is
# 0x8cC51c3008b3f03Fe483B28B8Db90e19cF076a6d, the aliased L1 owner.
# BaseTime 0x4200...0030 implementation slot is empty and admin is 0x4200...0018.
# EXCLUDED: Denim installs BaseTime only while that implementation slot is empty.

# v8.4.0.rc2, with AggregateVerifier 0.3.0 (fork-gated proposal intervals).
# https://github.com/base/contracts/commits/releases/v8.4.0/
BASE_CONTRACTS_COMMIT=8c21f6d08a36b4059ae2bb8938f1e7e758a0e962

# Rollback anchor verified against Zeronet on 2026-10-07 (AggregateVerifier 0.2.0).
GAME_TYPE=621
OLD_AGGREGATE_VERIFIER=0x90ab3A3a747a60EF56919574dA1766F20ACEe21C

# Post-Denim proposal intervals. The slow pair (600/30) is copied from the live verifier. At 200ms
# blocks, 6000/300 keeps the 20 minute range and the 20 intermediate roots per game.
FAST_BLOCK_INTERVAL=6000
FAST_INTERMEDIATE_BLOCK_INTERVAL=300

# AggregateVerifier proof program hashes. Every other constructor argument is read from the live
# implementation at deploy time.
#
# All three are built from the base/base node release these games prove against,
# v1.5.0-rc.6 (39147e3), the release running on the Zeronet nodes:
# https://github.com/base/base/tree/v1.5.0-rc.6
#
# The TEE image hash is keccak256 of PCR0 of the AWS Nitro enclave image. PCR0 is printed by the
# Nitro Prover Enclave Build of protocols/base-proofs#494, which pins the enclave to that commit:
#   PCR0=6661d615d72bfaddeb46f072c697294dcebdd4ebf23059f9cab944cc4b539c530a3ba26aee482235887faac2909d4221
#   cast keccak 0x$PCR0
AGGREGATE_VERIFIER_TEE_IMAGE_HASH=0x5bc8c8805622c1ba2e835083f53ba82a181e78afd7ba8882fc4cde265380fc98

# The two ZK hashes are the SP1 range and aggregation verification keys printed by
# `just succinct vkeys --build` on that ref: both ELFs built reproducibly with
# `cargo prove build --docker` (SP1 v6.8.1 image), then the `vkeys` binary.
AGGREGATE_VERIFIER_ZK_RANGE_HASH=0x384a748252305244324ab53f049a775127babdd77d70de513c2d08c865e3da96
AGGREGATE_VERIFIER_ZK_AGGREGATE_HASH=0x00ab89c9dc2c1d164a9ae9a4c182983778eed8443a470d9d1d24a6d7a36e7453

# Denim (upgrade id 13) activation: 2026-10-14 18:00:00 UTC.
#   date -u -r 1792000800
PROTOCOL_VERSIONS_DENIM_ACTIVATION_TIMESTAMP=1792000800

# Packed protocol versions: v1.4.0 -> v1.5.0. The OP format packs the low 16 bytes as
# major || minor || patch || pre-release, four bytes each. Re-derive with:
#   cast to-dec 0x00000001000000040000000000000000
#   cast to-dec 0x00000001000000050000000000000000
PROTOCOL_VERSIONS_CURRENT_MINIMUM_PROTOCOL_VERSION=79228162588051313888382156800
PROTOCOL_VERSIONS_MINIMUM_PROTOCOL_VERSION=79228162606498057962091708416

# v8.4.0, with AggregateVerifier 0.3.0 (fork-gated proposal intervals).
# https://github.com/base/contracts/tree/v8.4.0
# Annotated tag 55c80422c056afc2d8b5365060d47b8f5bce5b64 points to this commit, also v8.4.0.rc2.
BASE_CONTRACTS_COMMIT=8c21f6d08a36b4059ae2bb8938f1e7e758a0e962

# Live reads below: Sepolia L1 block 11930841, 2026-10-17 00:46:48 UTC.
# Contract addresses and the configured L1_RPC_URL are in config/sepolia.env at the repository root.
# DisputeGameFactory 0xd6E6dBf4F7EA0ac412fD8b65ED297e64BB7a06E1: gameImpls(621).
# The returned verifier reports gameType() = 621 and version() = "0.2.0".
GAME_TYPE=621
OLD_AGGREGATE_VERIFIER=0xd702aaE6221f36Dfe7e8EBC4315D64344A9dB4CB

# Post-Denim proposal intervals. The live verifier above reports BLOCK_INTERVAL() = 600 and
# INTERMEDIATE_BLOCK_INTERVAL() = 30 at block 11930841. At 200ms blocks, 6000/300 keeps the
# 20 minute range and the 20 intermediate roots per game.
# Cadence: base/base v1.5.0, crates/common/genesis/src/schedule.rs (DENIM_BLOCK_INTERVAL_MILLIS).
# The v1.5.0 proposer selects intervals per game; the proof build below fixes its prover:
# https://github.com/base/base/blob/v1.5.0/crates/proof/proposer/src/proposal_intervals.rs
FAST_BLOCK_INTERVAL=6000
FAST_INTERMEDIATE_BLOCK_INTERVAL=300

# AggregateVerifier proof program hashes. Every other constructor argument is read from the live
# implementation at deploy time.
#
# All three are built from base/base f3a459f, v1.5.0-rc.6 plus the per-game intermediate block
# interval fix, which passes each game's intermediate block interval to the provers:
# f3a459feaf4b071f311940510055b4b55b9374b8
# These hashes take effect when this task executes, not at Denim. Before execution, Base Sepolia's
# proposer and provers must run this build and its enclave signers must be registered in
# TEEProverRegistry (see FACILITATOR.md). v1.5.0's prover hardcodes 300, while
# AggregateVerifier 0.3.0 keeps the live 600/30 pair for games starting before Denim.
# The proof programs are chain-agnostic, so these equal Zeronet's live Denim verifier hashes:
# archive/evm/2026-10-13-update-denim-verifier-hashes/config/zeronet/.env
#
# The TEE image hash is keccak256 of PCR0 of the AWS Nitro enclave image built reproducibly from that
# commit:
#   PCR0=2cbd0c628d01431b2417e71882a3c4eb9dd1144cb35859fc3074ef18b737efccebe5ad83d42f5daf1cc84128befd5056
#   cast keccak 0x$PCR0
AGGREGATE_VERIFIER_TEE_IMAGE_HASH=0x44cca4430eaac037ec451534ff7c9361095fa36e0f53fac9fa03f8305c879ef7

# The two ZK hashes are the SP1 range and aggregation verification keys printed by
# `just succinct vkeys --build` on that commit: both ELFs built reproducibly with
# `cargo prove build --docker` (SP1 v6.8.1 image), then the `vkeys` binary.
AGGREGATE_VERIFIER_ZK_RANGE_HASH=0x6b1c20d0762f77b5278bd8aa5a0bb0ef3d6f3d9411bdad6d4f929a0701876e35
AGGREGATE_VERIFIER_ZK_AGGREGATE_HASH=0x0046d94f58f278df6197b4f433b63085aa95999893811f6ba6dff7e001425ca7

# Denim (upgrade id 13) activation: 2026-10-21 18:00:00 UTC.
# base/base v1.5.0 (e0fe7fa0bef1dbeb27d1ccf05df0f8f9fa545832), SEPOLIA chain_id 84532,
# denim_timestamp = Some(1_792_605_600):
# https://github.com/base/base/blob/v1.5.0/crates/common/chains/src/config.rs
#   date -u -r 1792605600
# ProtocolVersions 0x15B721B12CF3b0C4400c8a2935A0Ae391c2eF65b at block 11930841:
# getSchedule() has 13 entries, ending at 1790186400; MIN_NOTICE() = 3600.
# Activation is 407592 seconds after that block, outside MIN_NOTICE. Recheck before execution.
PROTOCOL_VERSIONS_DENIM_ACTIVATION_TIMESTAMP=1792605600

# Packed protocol versions: v1.4.0 -> v1.5.0. The OP format packs the low 16 bytes as
# major || minor || patch || pre-release, four bytes each. Re-derive with:
#   cast to-dec 0x00000001000000040000000000000000
#   cast to-dec 0x00000001000000050000000000000000
# Current value: ProtocolVersions 0x15B721B12CF3b0C4400c8a2935A0Ae391c2eF65b,
# minimumProtocolVersion() at Sepolia L1 block 11930841, 2026-10-17 00:46:48 UTC.
PROTOCOL_VERSIONS_CURRENT_MINIMUM_PROTOCOL_VERSION=79228162588051313888382156800
# New minimum: the base/base v1.5.0 release that activates Denim on Base Sepolia.
# https://github.com/base/base/releases/tag/v1.5.0
PROTOCOL_VERSIONS_MINIMUM_PROTOCOL_VERSION=79228162606498057962091708416

UPGRADE_SCRIPT_NAME=ExecuteDenimUpgradeWithL2Predeploys

# Live reads, 2026-10-17 UTC, Base Sepolia L2 block 48217316:
# SequencerFeeVault 0x4200000000000000000000000000000000000011,
# BaseFeeVault 0x4200000000000000000000000000000000000019 and
# L1FeeVault 0x420000000000000000000000000000000000001a each report:
# RECIPIENT() = 0x76355A67fCBCDE6F9a69409A8EAd5EaA9D8d875d, WITHDRAWAL_NETWORK() = 1,
# MIN_WITHDRAWAL_AMOUNT() = 2000000000000000000, version() = "1.4.0".
# Their lowercase recipient(), withdrawalNetwork(), minWithdrawalAmount() getters revert on 1.4.0.
# The recipient has 1986 bytes of code on L2 at that block and none on Sepolia L1 block 11931229.
# Keep L2 withdrawals: the recipient is an L2 contract and all three vaults already withdraw to it.
FEE_VAULT_RECIPIENT=0x76355A67fCBCDE6F9a69409A8EAd5EaA9D8d875d
FEE_VAULT_MIN_WITHDRAWAL_AMOUNT=2000000000000000000
FEE_VAULT_WITHDRAWAL_NETWORK=1

# At the same L2 block/date, L2ToL1MessagePasser 0x4200000000000000000000000000000000000016
# version() = "1.1.0"; L1Block 0x4200000000000000000000000000000000000015 version() = "1.7.0".
# L2 ProxyAdmin 0x4200000000000000000000000000000000000018 owner() =
# 0x20f984546476DDd290eC46318785046eF68a1Cba, the L2 alias of PROXY_ADMIN_OWNER.
# At the pinned v8.4.0 commit above, src/L2/{L2ToL1MessagePasser,L1Block}.sol implement ISemver
# with versions 1.2.0 and 1.8.0; {SequencerFeeVault,BaseFeeVault,L1FeeVault}.sol report 1.6.0.

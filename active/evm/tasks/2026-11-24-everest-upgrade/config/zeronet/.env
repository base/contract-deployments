# base/contracts v8.4.0, AggregateVerifier 0.3.0. The standby deploy script only supports this pin.
# AggregateVerifier and ProtocolVersions are unchanged in v8.5.0-rc.1 (b9b76d97), the Everest release.
# https://github.com/base/contracts/tree/8c21f6d08a36b4059ae2bb8938f1e7e758a0e962
BASE_CONTRACTS_COMMIT=8c21f6d08a36b4059ae2bb8938f1e7e758a0e962

# Hoodi L1 block 4078985: DisputeGameFactory.gameImpls(621), version() = "0.3.0".
# Network addresses and RPCs come from repository config/zeronet.env.
GAME_TYPE=621
CURRENT_AGGREGATE_VERIFIER=0x50521128e3eB8708F05129D7B7283737D55a1936

# TODO: Everest proof program hashes from the base/base v1.6.x build Zeronet's provers run at Everest.
# Every other constructor argument is read from CURRENT_AGGREGATE_VERIFIER at deploy time.
# TEE: keccak256 of PCR0 of the reproducible AWS Nitro enclave image, `cast keccak 0x$PCR0`.
# ZK: SP1 range and aggregation vkeys printed by `just succinct vkeys --build` on the same commit.
# The live hashes (v1.5.2 build) are 0x7318...5cbd / 0x3d37...5fdb / 0x00d5...d45a.
AGGREGATE_VERIFIER_TEE_IMAGE_HASH=
AGGREGATE_VERIFIER_ZK_RANGE_HASH=
AGGREGATE_VERIFIER_ZK_AGGREGATE_HASH=

# TODO: Everest (upgrade id 14) activation. Must match the activation the prover build uses, be after
# Denim (1792000800) and at least ProtocolVersions.MIN_NOTICE (3600s) after execution.
# At Hoodi L1 block 4078985 getSchedule() has 14 entries, ending with Denim at 1792000800.
EVEREST_ACTIVATION_TIMESTAMP=

# Packed protocol versions, major || minor || patch || pre-release, four bytes each.
# Current: v1.5.0, minimumProtocolVersion() at Hoodi L1 block 4078985.
#   cast to-dec 0x00000001000000050000000000000000
PROTOCOL_VERSIONS_CURRENT_MINIMUM_PROTOCOL_VERSION=79228162606498057962091708416
# New: v1.6.0. TODO: confirm against the base/base release that activates Everest on Zeronet.
#   cast to-dec 0x00000001000000060000000000000000
PROTOCOL_VERSIONS_MINIMUM_PROTOCOL_VERSION=79228162624944802035801260032

# Live values verified against Zeronet on 2026-10-08.
OLD_GAS_LIMIT=1200000000
OLD_EIP1559_DENOMINATOR=100

# At the first Denim block the node divides the gas limit by 10 and multiplies the EIP-1559
# denominator by 10 (base/base crates/consensus/derive/src/attributes/stateful.rs,
# DENIM_GAS_PARAMETER_SCALING_FACTOR). These are the values the chain runs with after Denim; this
# task writes them to SystemConfig so later L1 config updates do not revert them.
NEW_GAS_LIMIT=120000000
NEW_EIP1559_DENOMINATOR=1000

# v8.4.0.rc2, same pin as the Denim upgrade.
# https://github.com/base/contracts/commits/releases/v8.4.0/
BASE_CONTRACTS_COMMIT=8c21f6d08a36b4059ae2bb8938f1e7e758a0e962

# Fee vault config written by `initialize` during the upgrade. Recipient and minimum withdrawal are the live values.
# The live withdrawal network is L2 (1), which strands fees since the recipient is an L1 Safe with no code on L2,
# so it moves to L1 (0).
FEE_VAULT_RECIPIENT=0x3d59999977e0896ee1f8783bB8251DF16fb483E9
FEE_VAULT_MIN_WITHDRAWAL_AMOUNT=10000000000000000000
FEE_VAULT_WITHDRAWAL_NETWORK=0
